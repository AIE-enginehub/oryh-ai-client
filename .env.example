# The ORYH server and the model this deployment uses. Copy to .env and fill in.
# .env is not committed and not copied into the image.
ORYH_SERVER_ORIGIN=https://oryh.example.com
ORYH_MODEL_API_KEY=
ORYH_MODEL_BASE_URL=https://api.deepseek.com
ORYH_MODEL=deepseek-v4-flash
# off | low | high | max
ORYH_MODEL_REASONING_EFFORT=high
